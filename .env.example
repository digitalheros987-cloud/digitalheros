# Next.js Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Public)
# Found in Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase (Secret - Server Only)
# Used for admin tasks that bypass RLS (e.g., executing draws, webhook handling)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (Public)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Stripe (Secret - Server Only)
STRIPE_SECRET_KEY=your_stripe_secret_key

# Stripe Webhook Secret (Secret - Server Only)
# Used to verify incoming webhook signatures
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
